# Maintainer: nouveau-lab
# Mesa do lab (NVDEC/NVENC nativos H.264+AV1, NVK independente) no lugar do
# mesa-git do CachyOS. Mesmas funcionalidades do pacote do sistema.
# NVIDIA-DERIVED: private local use only, not for redistribution/upstream.
pkgbase=mesa-git
pkgname=mesa-git
epoch=1
pkgver=27.0.0_devel.r231968.gde8d36778cff
pkgrel=1
pkgdesc="Mesa (nvgd native OpenGL, NVK, direct GA107 NVDEC H.264/AV1/HEVC/VP9 + NVENC video) - private local use"
arch=('x86_64')
url="https://github.com/Geanziin/nvgd"
license=('custom')
depends=('libdrm' 'wayland' 'libxxf86vm' 'libxdamage' 'libxshmfence' 'libelf'
         'libomxil-bellagio' 'libunwind' 'lm_sensors' 'libglvnd' 'expat'
         'libclc' 'libx11' 'llvm-libs' 'spirv-tools' 'libdisplay-info'
         'libpng' 'zstd' 'vulkan-icd-loader' 'xcb-util-keysyms' 'systemd-libs')
makedepends=('meson' 'ninja' 'python-mako' 'python-ply' 'python-packaging'
             'python-yaml' 'glslang' 'cbindgen' 'rust' 'rust-bindgen'
             'spirv-llvm-translator' 'clang' 'llvm' 'libva' 'libxrandr'
             'wayland-protocols' 'xorgproto' 'libxml2' 'elfutils' 'flex'
             'bison' 'byacc' 'ocl-icd' 'libgcrypt')
optdepends=('opengl-man-pages: for the OpenGL API man pages')
provides=('mesa' 'vulkan-intel' 'vulkan-radeon' 'vulkan-nouveau'
          'vulkan-mesa-layers' 'mesa-vulkan-layers' 'libva-mesa-driver'
          'vulkan-driver' 'opencl-mesa' 'opengl-driver' 'opencl-driver'
          'ati-dri' 'intel-dri' 'nouveau-dri' 'svga-dri' 'mesa-dri'
          'mesa-libgl' 'vulkan-mesa-device-select' 'vulkan-swrast')
conflicts=('mesa' 'opencl-mesa' 'vulkan-intel' 'vulkan-radeon'
           'vulkan-nouveau' 'vulkan-mesa-device-select' 'vulkan-mesa-layers'
           'mesa-vulkan-layers' 'libva-mesa-driver' 'vulkan-swrast')
options=('!debug' 'strip')

_src=/home/gean/Documents/nouveau-lab/src/mesa

build() {
  CFLAGS+=' -g1'
  CXXFLAGS+=' -g1'
  if [ ! -f "$srcdir/_build/build.ninja" ]; then
    meson setup "$srcdir/_build" "$_src" \
    -D prefix=/usr -D sysconfdir=/etc -D buildtype=plain -D b_ndebug=true \
    -D b_lto=false -D android-libbacktrace=disabled -D egl=enabled \
    -D gallium-drivers=r300,r600,radeonsi,nouveau,virgl,svga,softpipe,llvmpipe,i915,iris,crocus,zink \
    -D gallium-extra-hud=true -D gallium-rusticl=true -D gallium-va=enabled \
    -D gbm=enabled -D gles1=disabled -D gles2=enabled -D glvnd=enabled \
    -D glx=dri -D libunwind=enabled -D llvm=enabled -D lmsensors=enabled \
    -D microsoft-clc=disabled -D platforms=x11,wayland -D valgrind=disabled \
    -D video-codecs=all \
    -D vulkan-drivers=amd,intel,intel_hasvk,swrast,virtio,nouveau \
    -D vulkan-layers=device-select,intel-nullhw,overlay,screenshot,vram-report-limit \
    -D tools=[] -D zstd=enabled -D legacy-x11=dri2 -D nouveau-nvenc=true \
    -D build-tests=false
  fi
  ninja -C "$srcdir/_build" -j"${LAB_JOBS:-8}"
}

package() {
  DESTDIR="$pkgdir" ninja -C "$srcdir/_build" install
  rm -f "$pkgdir/usr/bin/mesa-overlay-control.py" "$pkgdir/usr/bin/mesa-screenshot-control.py"
  rmdir "$pkgdir/usr/bin" 2>/dev/null || true
  ln -s /usr/lib/libGLX_mesa.so.0 "$pkgdir/usr/lib/libGLX_indirect.so.0"
  install -Dm644 "$_src/docs/license.rst" "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
