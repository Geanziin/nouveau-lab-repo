# Mesa 32-bit do lab: nvgd OpenGL (nvc0/NAK) + NVK, sem LLVM.
# NVIDIA-DERIVED: private local use only, not for redistribution/upstream.
pkgname=lib32-mesa-git
epoch=1
pkgver=27.0.0_devel.r231967.gbccf1fae57b9
pkgrel=1
pkgdesc="Mesa 32-bit (nvgd direct OpenGL driver and NVK) - private local use"
arch=('x86_64')
url="https://github.com/Geanziin/nvgd"
license=('custom')
depends=('mesa' 'lib32-libdrm' 'lib32-wayland' 'lib32-libxxf86vm' 'lib32-libxdamage'
         'lib32-libxshmfence' 'lib32-libelf' 'lib32-expat' 'lib32-libx11'
         'lib32-libxext' 'lib32-libxfixes' 'lib32-libxrandr' 'lib32-libxcb'
         'lib32-zlib' 'lib32-zstd' 'lib32-libdisplay-info' 'lib32-spirv-tools'
         'lib32-vulkan-icd-loader' 'lib32-systemd' 'lib32-gcc-libs' 'lib32-glibc')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'rust' 'rust-bindgen' 'cbindgen'
             'python-mako' 'python-yaml' 'glslang' 'wayland-protocols'
             'xorgproto' 'lib32-libxrandr')
provides=('lib32-mesa' 'lib32-vulkan-nouveau' 'lib32-vulkan-driver'
          'lib32-opengl-driver' 'lib32-nouveau-dri' 'lib32-mesa-dri'
          'lib32-mesa-libgl' 'lib32-vulkan-intel' 'lib32-vulkan-radeon'
          'lib32-vulkan-swrast' 'lib32-vulkan-mesa-device-select'
          'lib32-vulkan-mesa-layers' 'lib32-mesa-vulkan-layers'
          'lib32-libva-mesa-driver' 'lib32-opencl-mesa')
conflicts=('lib32-mesa' 'lib32-vulkan-nouveau' 'lib32-vulkan-intel'
           'lib32-vulkan-radeon' 'lib32-vulkan-swrast'
           'lib32-vulkan-mesa-device-select' 'lib32-vulkan-mesa-layers'
           'lib32-mesa-vulkan-layers' 'lib32-libva-mesa-driver'
           'lib32-opencl-mesa')
options=('!debug' 'strip')
source=()
sha256sums=()

# Native shader tools come from the lab's 64-bit build. The cross file is
# shipped with the recipe instead of relying on wrappers in /tmp after reboot.
_src=/home/gean/Documents/nouveau-lab/src/mesa
_native_build=/home/gean/Documents/nouveau-lab/packaging/mesa-git-lab/src/_build

build() {
  local _build="$srcdir/_build"
  # NVK's build-time shader tools run natively, not as i686 binaries.
  export PATH="$_native_build/src/compiler/clc:$_native_build/src/compiler/spirv:$PATH"
  export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
  export BINDGEN_EXTRA_CLANG_ARGS="--target=i686-unknown-linux-gnu"
  # This preconfigured cross build does not inherit makepkg's optimization
  # flags. Set Meson's optimization for both C/C++ (NVK/NIR) and Rust (NAK).
  # Keep the i686 CPU baseline so repository packages remain portable.
  if [[ ! -f "$_build/build.ninja" ]]; then
    meson setup "$_build" "$_src" --cross-file "$startdir/meson-i686.ini" \
      -Dprefix=/usr -Dlibdir=lib32 -Dsysconfdir=/etc \
      -Dbuildtype=release -Doptimization=3 -Db_ndebug=true -Db_lto=false \
      -Dandroid-libbacktrace=disabled -Degl=enabled \
      -Dgallium-drivers=nouveau,softpipe,zink -Dgallium-extra-hud=false \
      -Dgallium-rusticl=false -Dgallium-va=disabled -Dgbm=enabled \
      -Dgles1=disabled -Dgles2=enabled -Dglvnd=enabled -Dglx=dri \
      -Dlibunwind=disabled -Dllvm=disabled -Dlmsensors=disabled \
      -Dmicrosoft-clc=disabled -Dmesa-clc=system -Dplatforms=x11,wayland \
      -Dvalgrind=disabled -Dvideo-codecs=[] -Dvulkan-drivers=nouveau \
      -Dvulkan-layers=device-select -Dtools=[] -Dzstd=enabled \
      -Dlegacy-x11=dri2 -Dnouveau-nvenc=false -Dbuild-tests=false
  fi
  meson configure "$_build" -Dbuildtype=release -Doptimization=3 -Db_ndebug=true
  ninja -C "$_build" -j"${LAB_JOBS:-12}"
}

package() {
  local _build="$srcdir/_build"
  DESTDIR="$pkgdir" ninja -C "$_build" install

  # Arquivos independentes de arquitetura pertencem ao mesa-git 64-bit.
  rm -rf "$pkgdir/usr/include" "$pkgdir/usr/share/drirc.d" \
         "$pkgdir/usr/share/glvnd" "$pkgdir/usr/share/man" \
         "$pkgdir/usr/share/doc" "$pkgdir/usr/bin" \
         "$pkgdir/usr/share/vulkan/implicit_layer.d" \
         "$pkgdir/usr/share/vulkan/explicit_layer.d"

  ln -sf /usr/lib32/libGLX_mesa.so.0 "$pkgdir/usr/lib32/libGLX_indirect.so.0"
  install -Dm644 "$_src/docs/license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
